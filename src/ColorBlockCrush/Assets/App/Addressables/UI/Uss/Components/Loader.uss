.loader {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.loader--hidden {
    display: none;
}

.loader--visible {
    display: flex;
}

.loader-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--color-overlay);
}

.loader__content {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.loader__spinner {
    width: var(--size-spinner);
    height: var(--size-spinner);
    border-width: var(--border-width-lg);
    border-color: var(--color-primary);
    border-top-color: transparent;
    border-radius: 50%;
}