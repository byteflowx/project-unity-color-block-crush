.error {
    position: absolute;
    width: 100%;
    height: 100%;
}

.error--hidden {
    display: none;
}

.error--visible {
    display: flex;
}

.error__overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--color-overlay-popup);
}

.error__popup {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 80%;
    max-width: var(--popup-max-width-sm);
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    border-width: var(--border-width-sm);
    border-color: var(--color-error);
    padding: var(--layout-modal-padding);
    align-items: center;
}

.error__message {
    font-size: var(--font-base);
    color: var(--color-text);
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: var(--space-xl);
}

.error__actions {
    flex-direction: row;
    justify-content: center;
    width: 100%;
}

.error__actions > .error__btn {
    margin-left: var(--space-sm);
    margin-right: var(--space-sm);
}

.error__btn {
    min-width: var(--size-button-min-width-sm);
    height: var(--size-button-height-sm);
    border-radius: var(--radius-md);
    font-size: var(--font-base);
    -unity-font-definition: var(--font-semibold);
    border-width: var(--border-width-md);
    cursor: link;
    transition-property: scale, opacity;
    transition-duration: var(--transition-fast);
}

.error__btn:active {
    scale: var(--scale-press) var(--scale-press);
}

.error__btn--primary {
    background-color: var(--color-primary);
    border-color: var(--color-primary-dark);
    color: var(--color-text);
}

.error__btn--secondary {
    background-color: transparent;
    border-color: var(--color-border);
    color: var(--color-text-secondary);
}