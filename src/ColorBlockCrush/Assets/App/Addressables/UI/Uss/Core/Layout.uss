.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.screens-container {
    position: absolute;
    width: 100%;
    height: 100%;
}

.screen-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--color-background);
    display: none;
}

.screen-overlay--visible {
    display: flex;
}

.screens-content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.popups-container {
    position: absolute;
    width: 100%;
    height: 100%;
}

.popups-content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.popup-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: transparent;
    transition-property: background-color;
    transition-duration: var(--transition-normal);
    transition-timing-function: ease-out;
    display: none;
}

.popup-overlay--visible {
    display: flex;
    background-color: var(--color-overlay-popup);
}

.popup {
    position: absolute;
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--layout-modal-padding);
    border-width: var(--border-width-sm);
    border-color: var(--color-border);
    transition-property: opacity, scale;
    transition-duration: var(--transition-normal);
    transition-timing-function: ease-out;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
}

.popup--visible {
    opacity: 1;
    scale: 1 1;
}

.popup--hidden {
    display: none;
}

.popup--sm {
    width: 80%;
    max-width: var(--popup-max-width-sm);
    max-height: 80%;
}

.popup--md {
    width: 85%;
    max-width: var(--popup-max-width-md);
    max-height: 85%;
}

.popup--lg {
    width: 90%;
    max-width: var(--popup-max-width-lg);
    max-height: 90%;
}

.popup__content {
    flex-grow: 1;
}

.popup__footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: var(--space-xl);
}

.popup__footer > * {
    margin-left: var(--space-md);
}
